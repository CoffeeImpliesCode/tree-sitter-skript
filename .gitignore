# Rust artifacts
target/
# This crate is a library, so Cargo resolves the lockfile per consumer.
Cargo.lock

# Node artifacts
build/
prebuilds/
node_modules/

# Swift artifacts
.build/
# This package is a library, so SwiftPM resolves dependencies per consumer.
Package.resolved
.swiftpm/

# Go artifacts
_obj/

# Python artifacts
.venv/
dist/
*.egg-info
*.whl
__pycache__/
*.pyc

# C artifacts
*.a
*.so
*.so.*
*.dylib
*.dll
*.pc
*.exp
*.lib

# Zig artifacts
# No trailing slash: these are symlinks to a local-disk cache here, because
# Zig's build runner cannot create its cache on the NFS mount this repo lives
# on (rename(2) returns EINVAL and readdir reports DT_UNKNOWN).
.zig-cache
zig-cache/
zig-out/
zig-pkg

# Example dirs
/examples/*/

# Grammar volatiles
*.wasm
*.obj
*.o

# Archives
*.tar.gz
*.tgz
*.zip
*.jar

# Other
.jj/
.devenv/
.direnv/
log.html

# tree-sitter test report
/result
